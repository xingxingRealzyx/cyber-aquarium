{
  "name": "cyber-aquarium",
  "productName": "Cyber Aquarium",
  "version": "0.6.4",
  "description": "澄境 · A living transparent desktop freshwater aquarium",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
